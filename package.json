{
  "name": "mcp-openapi-bridge",
  "version": "1.0.0",
  "description": "Generic MCP server that bridges any OpenAPI 3.x REST API to Claude Code — one tool per endpoint, auto-discovered from the spec.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-openapi-bridge": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "rest",
    "claude",
    "ai",
    "llm",
    "bridge",
    "anthropic"
  ],
  "license": "MIT",
  "mcpName": "io.github.murilojrpereira/mcp-openapi-bridge",
  "repository": {
    "type": "git",
    "url": "https://github.com/murilojrpereira/mcp-openapi-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/murilojrpereira/mcp-openapi-bridge/issues"
  },
  "homepage": "https://github.com/murilojrpereira/mcp-openapi-bridge#readme",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file .env dist/index.js",
    "dev": "nodemon --watch \"src/**\" --ext \"ts\" --exec \"npm run build && node --env-file .env dist/index.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "RUN_LIVE_TESTS=1 vitest run src/__tests__/live-smoke.test.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "lint-staged": {
    "*.ts": ["prettier --write", "eslint --fix"]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "nodemon": "^3.0.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.0"
  }
}
